# Local dev: path to the GCP service account key file (see docs/gcp-database-schema.md).
# Never commit the real key file — it's already in .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=./project-scrappy-intelic-a7055d2d24a2.json
BIGQUERY_PROJECT_ID=project-scrappy-intelic
BIGQUERY_DATASET=project_ether

# Production (Vercel etc.): there's no key file on disk there, so the same key is read
# from this var instead — base64 of the *entire* service account JSON file. Generate with:
#   node -e "console.log(require('fs').readFileSync('./project-scrappy-intelic-a7055d2d24a2.json').toString('base64'))"
# Leave unset locally — the file path above is used instead when this is empty.
GCP_SERVICE_ACCOUNT_KEY_BASE64=

# NextAuth session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
